# Copie para .env.local e preencha. Nunca commite o .env.local.
# Sem nenhuma variável o site roda em MODO PRÉVIA: nada é salvo, nada é cobrado, e a interface diz isso.
# Passo a passo de cada serviço em BACKEND.md.

# ─── Modo da loja ──────────────────────────────────────────────────────────────
# preview = sem servidor de loja (padrão)
# test    = banco + gateway de TESTE (Mercado Pago sandbox ou "mock"). Nenhuma cobrança real.
# live    = venda de verdade. O servidor se recusa a vender sem banco, segredo, Mercado Pago e e-mail configurados.
NEXT_PUBLIC_STORE_MODE=preview

# URL pública (canonical, sitemap, Open Graph, links de e-mail, retorno do Mercado Pago). https em produção.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Banco (Postgres) ─────────────────────────────────────────────────────────
# Vazio em preview/test = PGlite (Postgres local em arquivo, em LOCAL_DB_PATH). Obrigatório em live (ex.: Neon).
DATABASE_URL=
LOCAL_DB_PATH=.data/pglite
# true (padrão) = migra no primeiro acesso. Em produção prefira false + `npm run db:migrate` no deploy.
DB_AUTO_MIGRATE=true

# Segredo para assinar sessões, links de pedido e descadastro. 32+ caracteres aleatórios.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# ─── Pagamento ────────────────────────────────────────────────────────────────
# mercadopago | mock   (mock = simulador local, só em NEXT_PUBLIC_STORE_MODE=test)
PAYMENT_PROVIDER=mock
# Credenciais de TESTE ou produção em mercadopago.com.br/developers > Suas integrações.
MERCADOPAGO_ACCESS_TOKEN=
# Webhooks > Configurar notificações > "Assinatura secreta". Eventos: Order (Pix) e Pagamentos (cartão).
MERCADOPAGO_WEBHOOK_SECRET=
# Nome que aparece na fatura do cartão (até 13 caracteres)
MERCADOPAGO_STATEMENT_DESCRIPTOR=GEEKSWIM

# ─── Frete ────────────────────────────────────────────────────────────────────
# table = tabela fixa do catálogo (catalog.json > commerce.shippingTable) | melhorenvio = cotação real
SHIPPING_PROVIDER=table
MELHORENVIO_TOKEN=
MELHORENVIO_SANDBOX=true
# CEP de onde as peças saem (obrigatório com melhorenvio)
SHIP_FROM_CEP=

# ─── E-mail transacional ──────────────────────────────────────────────────────
# console = só imprime no terminal | resend = envia de verdade (obrigatório em live)
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=GEEK SWIM <pedidos@geekswim.com.br>

# ─── Painel /admin ────────────────────────────────────────────────────────────
# Vazio = painel desligado. Use uma senha longa.
ADMIN_PASSWORD=
# Recebe alerta de pedido pago e de pedido que precisa de revisão
ADMIN_EMAIL=

# ─── Medição (opcional) ───────────────────────────────────────────────────────
# Só carregam depois do aceite no aviso de cookies. Vazio = nenhum script de terceiro e nenhum aviso.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
