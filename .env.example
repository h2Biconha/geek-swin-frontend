# Copie para .env.local e preencha. Nunca commite o .env.local.
# Sem nenhuma variável o site roda inteiro em modo prévia (nada é salvo, nada é cobrado).

# URL pública do site (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Ligações do front (NEXT_PUBLIC_ = visível no navegador, NUNCA coloque segredo aqui) ---
# Lista de e-mail/WhatsApp. Ex.: /api/subscribe
NEXT_PUBLIC_SUBSCRIBE_URL=
# Checkout. Ex.: /api/checkout  (vazio = modo demonstração)
NEXT_PUBLIC_CHECKOUT_URL=
# Cotação de frete. Ex.: /api/shipping/quote  (vazio = valores de exemplo)
NEXT_PUBLIC_SHIPPING_URL=
# Analytics (vazio = nenhum script de terceiro carrega)
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# --- Só servidor ---
# mercadopago | stripe
PAYMENT_PROVIDER=mercadopago
MERCADOPAGO_ACCESS_TOKEN=
STRIPE_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
DATABASE_URL=
EMAIL_LIST_API_KEY=
SHIPPING_API_TOKEN=
